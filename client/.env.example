# Copy this file to .env.local and fill it in. Vite reads it when it starts.

# Where the ShopSmart API lives, ending in /api.
# Leave it empty in development: the client then calls /api and the Vite dev server
# passes those requests on to API_PROXY_TARGET.
# Set it for a production build hosted apart from the API, such as the Render static
# site in render.yaml: VITE_API_URL=https://<api>.onrender.com/api
# Vite writes it into the bundle at build time, so a change needs a new build.
VITE_API_URL=

# Development only: the Express server the Vite proxy forwards /api to.
API_PROXY_TARGET=http://localhost:5050
