# Copy this file to .env and fill it in. Never commit the real .env.
# The hosted API gets the same variables from render.yaml, apart from PORT (Render sets it)
# and the SEED_ and TEST_ ones, which only npm run seed and npm test read.
# development logs requests and puts stack traces in 500 answers; use production on the host.
NODE_ENV=development
PORT=5050

# Local MongoDB, for example: docker run -d --name shopsmart-mongo -p 27017:27017 mongo:7
# or a MongoDB Atlas connection string ending in /shopsmart?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/shopsmart
# npm test creates and drops its own shopsmart_test_* databases on the MongoDB at
# mongodb://127.0.0.1:27017. Set this to use another local one, never a real cluster.
# TEST_MONGO_BASE_URI=mongodb://127.0.0.1:27017

# A long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production the server refuses one shorter than 32 characters, or this example value.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Frontend origins allowed to call the API, comma separated. Required in production,
# as bare origins such as https://<site>.onrender.com (no path, no trailing slash, lower
# case). In development any localhost port is allowed as well.
CLIENT_URL=http://localhost:3000

# Requests per 15 minutes per visitor
AUTH_RATE_LIMIT_MAX=50
AI_RATE_LIMIT_MAX=60
# New review summaries the whole server may ask Gemini for each day (from midnight UTC).
# AI search shares the key's daily quota, so keep this well under it.
AI_SUMMARY_DAILY_MAX=100

# Google Gemini (https://aistudio.google.com/apikey). The key stays on the server and
# powers POST /api/ai/search and GET /api/products/:id/review-summary. Without it those
# answer 503 AI_UNAVAILABLE and the client falls back to its on-device search parser.
GEMINI_API_KEY=
# gemini-3.5-flash-lite is quick, has a free tier and had no shutdown date in Nov 2026.
# gemini-2.5-flash, the earlier default, only serves accounts that used it before and
# shuts down on 1 Dec 2026.
GEMINI_MODEL=gemini-3.5-flash-lite
# How long to wait for Gemini, in milliseconds, before answering 504 AI_TIMEOUT
GEMINI_TIMEOUT_MS=9000

# The store's time zone (IANA name). The admin dashboard counts each day's sales from
# midnight in this zone.
STORE_TIMEZONE=Asia/Kolkata

# The admin account npm run seed creates. Keep these values: the sign in page's one-click
# demo button signs in with them. The seed also creates demo@shopsmart.dev / Demo@1234
# and gives it two weeks of demo orders.
SEED_ADMIN_EMAIL=admin@shopsmart.dev
SEED_ADMIN_PASSWORD=Admin@1234

# The seeded admin and demo@shopsmart.dev are shared by every visitor of the demo, so
# the API will not change their password, sign them out everywhere, demote or delete
# them. List other emails here, or leave it empty to treat them like any other account.
# DEMO_ACCOUNT_EMAILS=admin@shopsmart.dev,demo@shopsmart.dev
