{
  "name": "shopsmart-api",
  "version": "1.0.0",
  "description": "ShopSmart REST API - Node.js, Express and MongoDB with JWT authentication and Gemini powered shopping features",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "seed": "node scripts/seed.js",
    "snapshot": "node scripts/buildCatalogueSnapshot.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "keywords": [
    "mern",
    "express",
    "mongodb",
    "jwt",
    "gemini",
    "ecommerce"
  ],
  "author": "Fathima K H",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "nodemonConfig": {
    "watch": [
      "index.js",
      "app.js",
      "config",
      "controllers",
      "middleware",
      "models",
      "routes",
      "services",
      "utils",
      "validators"
    ],
    "ext": "js,json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}
